<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required for making HTTP calls to the NotifyMVP backend -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Required on Android 13+ for showing push notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!--
            Firebase Messaging Service — handles:
            - Token refresh  → auto re-registers with NotifyMVP backend
            - Foreground messages → delivers to NotifyMessageListener

            Host app must include this in their AndroidManifest.xml:

            <service
                android:name="com.notifymvp.sdk.NotifyMvpMessagingService"
                android:exported="false">
                <intent-filter>
                    <action android:name="com.google.firebase.MESSAGING_EVENT" />
                </intent-filter>
            </service>
        -->
    </application>

</manifest>
