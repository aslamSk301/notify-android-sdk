<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required for making HTTP calls to the NotifyMVP backend -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Required on Android 13+ for showing push notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!-- Default FCM Notification Channel ID for background notifications (Android 8.0+ / API 26+) -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="notifymvp_heads_up_v4" />

        <!--
            Firebase Messaging Service — handles token refresh and foreground push notifications.
            Auto-merged into host application manifest.
        -->
        <service
            android:name="com.notifymvp.sdk.NotifyMvpMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
